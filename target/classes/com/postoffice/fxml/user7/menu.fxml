<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="24.0" prefWidth="800.0" prefHeight="600.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controllers.GoalSelectionController">
    <children>
        <Label text="Post Office Manager - Choose a goal">
            <font><Font name="Arial Black" size="24.0" /></font>
        </Label>
        <GridPane hgap="16.0" vgap="16.0" alignment="CENTER">
            <children>
                <Button id="user7/user7goal1.fxml" text="Goal 1" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button id="user7/user7goal2.fxml" text="Goal 2" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button id="user7/user7goal3.fxml" text="Goal 3" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Button id="user7/user7goal4.fxml" text="Goal 4" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Button id="user7/user7goal5.fxml" text="Goal 5" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button id="user7/user7goal6.fxml" text="Goal 6" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button id="user7/user7goal7.fxml" text="Goal 7" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Button id="user7/user7goal8.fxml" text="Goal 8" onAction="#openGoal" prefWidth="180.0" prefHeight="55.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </children>
        </GridPane>
    </children>
</VBox>
