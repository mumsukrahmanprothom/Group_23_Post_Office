<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.FinanceController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Revenue &amp; Expenses" styleClass="section-title"/>
    <Label text="Revenue is added automatically when a transaction is approved; approved refunds become expenses." styleClass="muted-label" wrapText="true"/>
    <Label fx:id="todayLabel" styleClass="money-label"/>
    <Label fx:id="totalLabel" styleClass="muted-label"/>
    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Show:"/><ComboBox fx:id="filterCombo" onAction="#handleFilter"/></HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="ID" prefWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="90"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Type" prefWidth="90"><cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory></TableColumn>
            <TableColumn text="Category" prefWidth="130"><cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory></TableColumn>
            <TableColumn text="Amount (BDT)" prefWidth="110"><cellValueFactory><PropertyValueFactory property="amountText"/></cellValueFactory></TableColumn>
            <TableColumn text="Description" prefWidth="260"><cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox fx:id="expenseBox" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="categoryField" promptText="Expense category" prefWidth="160"/>
        <TextField fx:id="amountField" promptText="Amount" prefWidth="100"/>
        <TextField fx:id="descriptionField" promptText="Description" HBox.hgrow="ALWAYS"/>
        <Button text="Record Expense" onAction="#handleAddExpense" styleClass="primary"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
