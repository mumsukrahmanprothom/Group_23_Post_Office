<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.AccountsController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Staff Accounts" styleClass="section-title"/>
    <Label text="Login accounts for Assistant Post Masters." styleClass="muted-label" wrapText="true"/>
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS" prefHeight="170">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="Username" prefWidth="120"><cellValueFactory><PropertyValueFactory property="username"/></cellValueFactory></TableColumn>
            <TableColumn text="Full name" prefWidth="180"><cellValueFactory><PropertyValueFactory property="fullName"/></cellValueFactory></TableColumn>
            <TableColumn text="Role" prefWidth="160"><cellValueFactory><PropertyValueFactory property="role"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="80"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="newUsernameField" promptText="Username"/>
        <TextField fx:id="newFullNameField" promptText="Full name"/>
        <PasswordField fx:id="newPasswordField" promptText="Password"/>
        <Button text="Create Assistant" onAction="#handleCreateAssistant" styleClass="primary"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Reset Password" onAction="#handleResetPassword"/>
        <Button text="Enable / Disable" onAction="#handleToggleActive"/>
        <Button text="Delete Account" onAction="#handleDeleteAccount"/>
        <Label fx:id="accountStatusLabel" styleClass="status-label"/>
    </HBox>
    <Separator/>
    <Label text="Staff List" styleClass="section-title"/>
        <TableView fx:id="staffTable" VBox.vgrow="ALWAYS" prefHeight="170">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="Name" prefWidth="220"><cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory></TableColumn>
            <TableColumn text="Position" prefWidth="220"><cellValueFactory><PropertyValueFactory property="position"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="staffNameField" promptText="Name"/>
        <TextField fx:id="staffPositionField" promptText="Position"/>
        <Button text="Add Staff Member" onAction="#handleAddStaff" styleClass="primary"/>
        <Button text="Remove Selected" onAction="#handleRemoveStaff"/>
        <Label fx:id="staffStatusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
