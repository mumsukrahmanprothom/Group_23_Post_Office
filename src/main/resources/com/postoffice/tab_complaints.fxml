<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.ComplaintsController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Customer Complaints" styleClass="section-title"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="200" onMouseClicked="#handleRowSelected" onKeyReleased="#handleRowSelected">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="ID" prefWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="90"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Customer" prefWidth="130"><cellValueFactory><PropertyValueFactory property="customer"/></cellValueFactory></TableColumn>
            <TableColumn text="Subject" prefWidth="200"><cellValueFactory><PropertyValueFactory property="subject"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="90"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <TextArea fx:id="detailArea" editable="false" prefRowCount="6" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Mark In Review" onAction="#handleInReview"/>
        <Button text="Add Note" onAction="#handleAddNote"/>
        <Button fx:id="resolveBtn" text="Resolve" onAction="#handleResolve" styleClass="primary"/>
    </HBox>
    <HBox spacing="8" alignment="TOP_LEFT">
        <VBox spacing="6" prefWidth="260">
            <TextField fx:id="customerField" promptText="Customer"/>
            <TextField fx:id="subjectField" promptText="Subject"/>
        </VBox>
        <TextArea fx:id="detailsField" promptText="Complaint details" prefRowCount="2" HBox.hgrow="ALWAYS"/>
        <VBox spacing="6"><Button text="Register Complaint" onAction="#handleRegister" styleClass="primary"/>
        <Label fx:id="statusLabel" styleClass="status-label"/></VBox>
    </HBox>
</VBox>
