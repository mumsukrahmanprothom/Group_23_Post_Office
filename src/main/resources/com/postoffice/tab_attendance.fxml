<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.AttendanceController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Staff Attendance" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Show:"/><ComboBox fx:id="filterCombo" onAction="#handleFilter"/><Label fx:id="summaryLabel" styleClass="muted-label"/></HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="Date" prefWidth="100"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Staff" prefWidth="200"><cellValueFactory><PropertyValueFactory property="staff"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="100"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
            <TableColumn text="Recorded by" prefWidth="120"><cellValueFactory><PropertyValueFactory property="recordedBy"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="staffCombo" prefWidth="200"/>
        <ComboBox fx:id="statusCombo"/>
        <Button text="Record for Today" onAction="#handleRecord" styleClass="primary"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
