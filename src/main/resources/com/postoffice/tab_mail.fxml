<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.MailController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Mail &amp; Parcels" styleClass="section-title"/>
    <Label text="Process mail, follow parcel delivery, review tracking history and verify delivery records." styleClass="muted-label" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Show:"/><ComboBox fx:id="viewCombo" onAction="#handleFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="trackField" promptText="Tracking no. e.g. PO-1001" prefWidth="190" onAction="#handleTrack"/>
        <Button text="Track" onAction="#handleTrack"/></HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="230" onMouseClicked="#handleRowSelected" onKeyReleased="#handleRowSelected">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="Tracking no." prefWidth="90"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Type" prefWidth="70"><cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory></TableColumn>
            <TableColumn text="Sender" prefWidth="120"><cellValueFactory><PropertyValueFactory property="sender"/></cellValueFactory></TableColumn>
            <TableColumn text="Recipient" prefWidth="120"><cellValueFactory><PropertyValueFactory property="recipient"/></cellValueFactory></TableColumn>
            <TableColumn text="Destination" prefWidth="100"><cellValueFactory><PropertyValueFactory property="destination"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="120"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
            <TableColumn text="Verified" prefWidth="70"><cellValueFactory><PropertyValueFactory property="verifiedText"/></cellValueFactory></TableColumn>
            <TableColumn text="Last update" prefWidth="130"><cellValueFactory><PropertyValueFactory property="lastUpdated"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Next Stage" onAction="#handleAdvance" styleClass="primary"/>
        <Button text="Verify Delivery" onAction="#handleVerify"/>
        <Button text="Return to Sender" onAction="#handleReturn"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
    <TextArea fx:id="historyArea" editable="false" prefRowCount="5" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="categoryCombo"/>
        <TextField fx:id="senderField" promptText="Sender" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="recipientField" promptText="Recipient" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="destinationField" promptText="Destination" HBox.hgrow="ALWAYS"/>
        <Button text="Register Item" onAction="#handleRegister" styleClass="primary"/>
    </HBox>
</VBox>
