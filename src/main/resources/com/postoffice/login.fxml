<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Post Office Simulation">
         <style>-fx-font-size: 22px; -fx-font-weight: bold;</style>
      </Label>
      <Label text="Please log in" />
      <TextField fx:id="usernameField" promptText="Username" />
      <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Password" />
      <ComboBox fx:id="roleCombo" maxWidth="Infinity" />
      <Button defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" text="Login" />
      <Label fx:id="errorLabel" textFill="RED" />
   </children>
</VBox>
