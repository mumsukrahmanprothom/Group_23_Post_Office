<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.RefundsController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Refund Requests" styleClass="section-title"/>
    <Label fx:id="noteLabel" styleClass="muted-label"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="ID" prefWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="90"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Customer" prefWidth="130"><cellValueFactory><PropertyValueFactory property="customer"/></cellValueFactory></TableColumn>
            <TableColumn text="Amount (BDT)" prefWidth="100"><cellValueFactory><PropertyValueFactory property="amountText"/></cellValueFactory></TableColumn>
            <TableColumn text="Reason" prefWidth="220"><cellValueFactory><PropertyValueFactory property="reason"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="80"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
            <TableColumn text="Verified by" prefWidth="100"><cellValueFactory><PropertyValueFactory property="verifiedBy"/></cellValueFactory></TableColumn>
            <TableColumn text="Decided by" prefWidth="100"><cellValueFactory><PropertyValueFactory property="decidedBy"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="customerField" promptText="Customer" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="amountField" promptText="Amount" prefWidth="100"/>
        <TextField fx:id="reasonField" promptText="Reason" HBox.hgrow="ALWAYS"/>
        <Button text="Submit Request" onAction="#handleSubmit" styleClass="primary"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Verify Selected" onAction="#handleVerify"/>
        <Button fx:id="approveBtn" text="Approve Selected" onAction="#handleApprove" styleClass="primary"/>
        <Button fx:id="rejectBtn" text="Reject Selected" onAction="#handleReject"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
