<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="24.0" prefWidth="800.0" prefHeight="600.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controllers.RoleSelectionController">
    <children>
        <Label text="Simulating Operations of a Post Office">
            <font><Font name="Arial Black" size="25.0" /></font>
        </Label>
        <Label text="Choose your role to view its goals" />
        <Button text="Post Office Manager" onAction="#openPostOfficeManager"
                prefWidth="300.0" prefHeight="55.0" />
        <Button text="Postal Worker" onAction="#openPostalWorker"
                prefWidth="300.0" prefHeight="55.0" />
    </children>
</VBox>
