<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.DutiesController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Staff Duties" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Show:"/><ComboBox fx:id="filterCombo" onAction="#handleFilter"/></HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="ID" prefWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Staff" prefWidth="150"><cellValueFactory><PropertyValueFactory property="staff"/></cellValueFactory></TableColumn>
            <TableColumn text="Task" prefWidth="240"><cellValueFactory><PropertyValueFactory property="task"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="90"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="90"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
            <TableColumn text="Assigned by" prefWidth="100"><cellValueFactory><PropertyValueFactory property="assignedBy"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="staffCombo" prefWidth="180"/>
        <TextField fx:id="taskField" promptText="Task / duty" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="dateField" promptText="yyyy-MM-dd" prefWidth="110"/>
        <Button text="Assign Duty" onAction="#handleAssign" styleClass="primary"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Mark In Progress" onAction="#handleInProgress"/>
        <Button text="Mark Done" onAction="#handleDone"/>
        <Button fx:id="removeBtn" text="Remove Duty" onAction="#handleRemove"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
