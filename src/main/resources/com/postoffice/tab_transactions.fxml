<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.TransactionsController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Counter Transactions" styleClass="section-title"/>
    <Label text="Record sales and approve them. Approved transactions become revenue automatically." styleClass="muted-label" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Show:"/><ComboBox fx:id="filterCombo" onAction="#handleFilter"/><Label fx:id="limitLabel" styleClass="muted-label"/></HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
          <columns>
            <TableColumn text="ID" prefWidth="80"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="90"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
            <TableColumn text="Type" prefWidth="120"><cellValueFactory><PropertyValueFactory property="type"/></cellValueFactory></TableColumn>
            <TableColumn text="Customer" prefWidth="140"><cellValueFactory><PropertyValueFactory property="customer"/></cellValueFactory></TableColumn>
            <TableColumn text="Amount (BDT)" prefWidth="100"><cellValueFactory><PropertyValueFactory property="amountText"/></cellValueFactory></TableColumn>
            <TableColumn text="Status" prefWidth="90"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
            <TableColumn text="Recorded by" prefWidth="100"><cellValueFactory><PropertyValueFactory property="createdBy"/></cellValueFactory></TableColumn>
            <TableColumn text="Decided by" prefWidth="100"><cellValueFactory><PropertyValueFactory property="decidedBy"/></cellValueFactory></TableColumn>
          </columns>
        </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="typeCombo"/>
        <TextField fx:id="customerField" promptText="Customer name" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="amountField" promptText="Amount" prefWidth="100"/>
        <Button text="Record Transaction" onAction="#handleRecord" styleClass="primary"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Approve Selected" onAction="#handleApprove" styleClass="primary"/>
        <Button text="Reject Selected" onAction="#handleReject"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
