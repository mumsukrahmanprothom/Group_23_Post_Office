<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.postoffice.controller.ReportsController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Reports" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="typeCombo" prefWidth="220"/>
        <Button text="Generate" onAction="#handleGenerate" styleClass="primary"/>
        <Button text="Save to File" onAction="#handleSave"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
    <TextArea fx:id="reportArea" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Monospaced';"/>
</VBox>
