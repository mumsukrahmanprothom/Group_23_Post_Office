<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.group_23_post_office.CustomerRequestController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Register Customer Request"/>

    <TextField fx:id="requestIdField" promptText="Request ID"/>
    <TextField fx:id="detailsField" promptText="Request Details"/>
    <TextField fx:id="dateField" promptText="Request Date"/>
    <TextField fx:id="statusField" promptText="Status"/>

    <Button text="Save Request" onAction="#saveRequest"/>

    <Label fx:id="messageLabel"/>

    <Button text="View Request List" onAction="#viewRequestList"/>

</VBox>
