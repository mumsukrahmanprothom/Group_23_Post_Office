<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.group_23_post_office.CustomerController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Manage Customer Information"/>

    <TextField fx:id="customerIdField" promptText="Customer ID"/>
    <TextField fx:id="nameField" promptText="Customer Name"/>
    <TextField fx:id="phoneField" promptText="Phone Number"/>
    <TextField fx:id="addressField" promptText="Address"/>
    <TextField fx:id="emailField" promptText="Email"/>

    <Button text="Save Customer" onAction="#saveCustomer"/>

    <Label fx:id="messageLabel"/>

    <Button text="View Customer List" onAction="#viewCustomerList"/>

</VBox>
