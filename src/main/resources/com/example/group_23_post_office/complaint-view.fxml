<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.group_23_post_office.ComplaintController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Handle Customer Complaints"/>

    <TextField fx:id="complaintIdField" promptText="Complaint ID"/>
    <TextField fx:id="detailsField" promptText="Complaint Details"/>
    <TextField fx:id="statusField" promptText="Status"/>
    <TextField fx:id="resolutionField" promptText="Resolution Note"/>

    <Button text="Save Complaint" onAction="#saveComplaint"/>

    <Label fx:id="messageLabel"/>

    <Button text="View Complaint List" onAction="#viewComplaintList"/>

</VBox>
