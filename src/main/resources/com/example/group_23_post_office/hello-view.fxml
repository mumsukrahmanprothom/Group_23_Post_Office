<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.group_23_post_office.HelloController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="POST OFFICE"/>
    <Label text="MANAGEMENT SYSTEM"/>
    <Label text="Welcome"/>

    <Button text="Customer Service Officer"
            onAction="#onCSOClick"/>

    <Button text="Manage Customer Information"
            onAction="#openCustomerForm"/>

    <Button text="Register Customer Request"
            onAction="#openRequestForm"/>

    <Button text="Handle Customer Complaints"
            onAction="#openComplaintForm"/>

    <Button text="Provide Postal Service Information"
            onAction="#openPostalServiceForm"/>

    <Button text="Mail Registration Officer"
            onAction="#onMROClick"/>

    <Label fx:id="welcomeText"/>

</VBox>